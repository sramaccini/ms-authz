<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.7</version>
        <relativePath/>
    </parent>

    <groupId>com.enterprise.auth</groupId>
    <artifactId>auth-service</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <name>Auth Service</name>
    <description>Microservizio di Autorizzazione: modello RBAC e arricchimento ruoli/permessi</description>

    <properties>
        <java.version>25</java.version>
        <!-- 3.0.x: linea di springdoc costruita su Spring Boot 4.0 (la 3.1+ richiede Boot 4.1) -->
        <springdoc.version>3.0.3</springdoc.version>
        <!-- Export della definizione OpenAPI nel build (fase integration-test): serve Docker, come i test.
             Saltato insieme ai test con -DskipTests, oppure da solo con -Dopenapi.export.skip=true. -->
        <skipTests>false</skipTests>
        <openapi.export.skip>${skipTests}</openapi.export.skip>
        <openapi.export.port>18081</openapi.export.port>
        <openapi.export.file>authz-admin-openapi-spec.json</openapi.export.file>
    </properties>

    <dependencies>
        <!-- Web MVC (servlet, bloccante: gira su Virtual Threads) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Sicurezza: endpoint protetto da JWT emesso dallo IAM -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-oauth2-resource-server</artifactId>
        </dependency>

        <!-- Persistenza: JDBC puro (JdbcClient) per join ottimizzate, Flyway per lo schema -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Definizione OpenAPI generata dal codice: GET /v3/api-docs (abilitata solo in sviluppo) -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-api</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- API di amministrazione: autenticazione con la sessione del BFF (X-Session-ID, lettura da Redis) -->
        <dependency>
            <groupId>com.enterprise.session</groupId>
            <artifactId>session-context-spring-boot-starter</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Test di integrazione su PostgreSQL reale (richiede Docker) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <!-- Avvia il servizio con PostgreSQL e Redis in container per l'export della definizione OpenAPI -->
                    <execution>
                        <id>openapi-start</id>
                        <goals>
                            <goal>start</goal>
                        </goals>
                        <configuration>
                            <skip>${openapi.export.skip}</skip>
                            <mainClass>com.enterprise.auth.TestAuthServiceApplication</mainClass>
                            <!-- dipendenze di test (Testcontainers) e classi di test (il launcher) -->
                            <useTestClasspath>true</useTestClasspath>
                            <additionalClasspathElements>
                                <additionalClasspathElement>${project.build.testOutputDirectory}</additionalClasspathElement>
                            </additionalClasspathElements>
                            <jmxPort>19001</jmxPort>
                            <maxAttempts>240</maxAttempts>
                            <arguments>
                                <argument>--server.port=${openapi.export.port}</argument>
                                <argument>--springdoc.api-docs.enabled=true</argument>
                                <argument>--springdoc.writer-with-default-pretty-printer=true</argument>
                                <argument>--AUTH_DB_PASSWORD=unused</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>openapi-stop</id>
                        <goals>
                            <goal>stop</goal>
                        </goals>
                        <configuration>
                            <skip>${openapi.export.skip}</skip>
                            <jmxPort>19001</jmxPort>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Scarica /v3/api-docs dal servizio avviato sopra: target/openapi/${openapi.export.file} -->
            <plugin>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-maven-plugin</artifactId>
                <version>1.5</version>
                <executions>
                    <execution>
                        <id>openapi-export</id>
                        <phase>integration-test</phase>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <skip>${openapi.export.skip}</skip>
                    <apiDocsUrl>http://localhost:${openapi.export.port}/v3/api-docs</apiDocsUrl>
                    <outputDir>${project.build.directory}/openapi</outputDir>
                    <outputFileName>${openapi.export.file}</outputFileName>
                    <failOnError>true</failOnError>
                </configuration>
            </plugin>
            <!-- Copia la definizione esportata in docs/ (versionata: contratto per la SPA e per la generazione del client) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>openapi-copy-to-docs</id>
                        <phase>post-integration-test</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <skip>${openapi.export.skip}</skip>
                            <outputDirectory>${project.basedir}/../docs</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.build.directory}/openapi</directory>
                                    <includes>
                                        <include>${openapi.export.file}</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
