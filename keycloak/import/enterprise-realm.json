{
  "realm": "enterprise",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": false,
  "duplicateEmailsAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "clients": [
    {
      "clientId": "bff-gateway",
      "name": "BFF Gateway",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${BFF_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:8080/login/oauth2/code/iam"],
      "webOrigins": ["http://localhost:8080"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:4200/*"
      }
    }
  ],
  "users": [
    {
      "username": "mario.rossi",
      "email": "mario.rossi@example.org",
      "firstName": "Mario",
      "lastName": "Rossi",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        { "type": "password", "value": "${DEMO_USER_PASSWORD}", "temporary": false }
      ]
    },
    {
      "username": "anna.bianchi",
      "email": "anna.bianchi@example.org",
      "firstName": "Anna",
      "lastName": "Bianchi",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        { "type": "password", "value": "${DEMO_USER_PASSWORD}", "temporary": false }
      ]
    },
    {
      "username": "admin.tenant.a",
      "email": "admin.tenant.a@example.org",
      "firstName": "Admin",
      "lastName": "Tenant A",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        { "type": "password", "value": "${DEMO_USER_PASSWORD}", "temporary": false }
      ]
    },
    {
      "username": "admin.globale",
      "email": "admin.globale@example.org",
      "firstName": "Admin",
      "lastName": "Globale",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        { "type": "password", "value": "${DEMO_USER_PASSWORD}", "temporary": false }
      ]
    }
  ]
}
