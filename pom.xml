<?xml version="1.0" encoding="UTF-8"?>
<!--
    Parent e aggregatore delle librerie ms-authz.
    "mvn install" dalla radice compila e testa librerie ed esempio. Le release si pubblicano su GitHub Packages
    dal workflow .github/workflows/release.yml (tag vX.Y.Z); l'esempio non viene pubblicato.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <groupId>com.enterprise.authz</groupId>
    <artifactId>ms-authz-parent</artifactId>
    <version>2.0.0</version>
    <packaging>pom</packaging>
    <name>ms-authz</name>
    <description>Librerie Spring Boot per login OIDC (BFF), sessione su Redis e RBAC per tenant.</description>
    <url>https://github.com/sramaccini/authz-library</url>

    <scm>
        <url>https://github.com/sramaccini/authz-library</url>
        <connection>scm:git:https://github.com/sramaccini/authz-library.git</connection>
        <tag>v${project.version}</tag>
    </scm>

    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages</name>
            <url>https://maven.pkg.github.com/sramaccini/authz-library</url>
        </repository>
    </distributionManagement>

    <properties>
        <java.version>25</java.version>
        <swagger-annotations.version>2.2.55</swagger-annotations.version>
    </properties>

    <modules>
        <module>authz-session</module>
        <module>authz-rbac</module>
        <module>authz-bff</module>
        <module>examples/authz-demo-app</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.enterprise.authz</groupId>
                <artifactId>authz-session</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.enterprise.authz</groupId>
                <artifactId>authz-rbac</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.enterprise.authz</groupId>
                <artifactId>authz-bff</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.swagger.core.v3</groupId>
                <artifactId>swagger-annotations-jakarta</artifactId>
                <version>${swagger-annotations.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <!-- Sorgenti pubblicati accanto ai jar: navigazione e debug dalle applicazioni che usano le librerie -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
